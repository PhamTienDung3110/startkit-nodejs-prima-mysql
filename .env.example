# =============================================
# PRODUCTION ENV — copy file này thành .env
# rồi điền giá trị thật vào
# =============================================

NODE_ENV=production
PORT=3001

# Database (trỏ tới container "db" trong docker network)
DATABASE_URL=mysql://root:CHANGE_ME@db:3306/le_backend
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=le_backend

# JWT — đổi thành chuỗi random dài ít nhất 32 ký tự
JWT_ACCESS_SECRET=CHANGE_ME_random_string_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=CHANGE_ME_another_random_string_min_32_chars
JWT_REFRESH_EXPIRES=7d

# CORS — điền domain Vercel của FE
CORS_ORIGIN=https://your-app.vercel.app,https://api.yourdomain.com
